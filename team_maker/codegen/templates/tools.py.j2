"""
tools.py — Tool bindings for this generated team.

Maps the tool names in agents/*.yaml to real instances.

Execution policy (P0 remediation, spec FR-006 to FR-018, FR-073 to FR-078):
  - Risky tools (shell, code_writer, test_runner, docker_runner) run ONLY
    inside a Docker sandbox. There is no environment variable or setting
    that disables this — sandboxing is mandatory, not opt-in.
  - Network access from the sandbox is {{ "permitted (operator-approved)" if network_allowed else "denied" }}
    by default; this generated package was built with
    SANDBOX_NETWORK = "{{ effective_network }}".
  - docker_runner's mount argument is validated against an operator-defined
    allowlist ({{ mount_allowlist|length }} entr{{ "y" if mount_allowlist|length == 1 else "ies" }}
    configured at build time). No mount reaching a dangerous location (host
    root, home directories, the Docker socket, device paths, system paths)
    is ever permitted, regardless of allowlist contents.
  - Every sandboxed execution is subject to mandatory resource limits: CPU
    {{ controls.cpu_limit }}, memory {{ controls.memory_limit }}, max
    processes {{ controls.max_processes }}, max output
    {{ controls.max_output_bytes }} bytes, storage {{ controls.storage_limit }}.
    Exceeding any limit terminates the tool and raises `ToolPolicyRefusal`
    rather than returning a silently-truncated result.
  - If the sandbox cannot be established (Docker missing, unreachable, or a
    control cannot be enforced), the tool call is refused. It never falls
    back to running on the host.

Requirements:
    pip install crewai crewai-tools PyGithub
"""
from __future__ import annotations

import hashlib
import json
import os
import shutil
import subprocess
from pathlib import Path
from typing import Any

from crewai.tools import tool
from state_store import read_state, write_state

try:
    from crewai_tools import FileReadTool, FileWriterTool, CodeDocsSearchTool, SerperDevTool
    _crewai_tools = True
except ImportError:
    _crewai_tools = False
    print("[warn] crewai-tools not installed — filesystem/web_search/code_reader unavailable.")


class ToolPolicyRefusal(Exception):
    """Raised whenever execution policy refuses a tool call: the sandbox
    could not be established, a mount was refused, or a resource limit was
    exceeded. Deliberately a raised exception, not a returned "[error] ..."
    string — the product's transcript capture (Phase 6) distinguishes a
    genuine tool failure from a successful call only via an exception
    reaching crewai's event system. Never caught and downgraded to a string
    return anywhere in this module."""


# ---------------------------------------------------------------------------
# Sandbox configuration — mandatory, no opt-out (spec FR-012, FR-073 to FR-078)
# ---------------------------------------------------------------------------
WORKSPACE_ROOT = os.environ.get("WORKSPACE_ROOT") or os.path.abspath("{{ sandbox.workspace_mount }}")
SANDBOX_IMAGE = "{{ sandbox.image }}"
SANDBOX_WORKSPACE = WORKSPACE_ROOT
SANDBOX_NETWORK = "{{ effective_network }}"
{% if sandbox.extra_env %}
SANDBOX_EXTRA_ENV: dict[str, str] = {
{% for key, val in sandbox.extra_env.items() %}
    "{{ key }}": os.environ.get("{{ key }}", "{{ val }}"),
{% endfor %}
}
{% else %}
SANDBOX_EXTRA_ENV: dict[str, str] = {}
{% endif %}

# Mandatory resource limits (spec FR-073 to FR-078). Rendered from the single
# authoritative defaults table (team_maker/tools/limits.py) at build time —
# never read from the process environment at run time, which is exactly the
# SANDBOX_ENABLED mistake this remediation removes, in a new costume.
TIMEOUT_PROCESS_SECONDS = {{ controls.timeout_process_seconds }}
TIMEOUT_CONTAINER_SECONDS = {{ controls.timeout_container_seconds }}
TIMEOUT_HTTP_SECONDS = {{ controls.timeout_http_seconds }}
MAX_OUTPUT_BYTES = {{ controls.max_output_bytes }}
CPU_LIMIT = "{{ controls.cpu_limit }}"
MEMORY_LIMIT = "{{ controls.memory_limit }}"
MAX_PROCESSES = {{ controls.max_processes }}
STORAGE_LIMIT = "{{ controls.storage_limit }}"

# Operator-configured mount allowlist for docker_runner (spec FR-014 to
# FR-017, FR-079). Empty means no mounts permitted. Agents cannot add to
# this list — it is baked in at build time from operator policy, never from
# a tool argument.
MOUNT_ALLOWLIST: list[dict[str, Any]] = [
{% for entry in mount_allowlist %}
    {"alias": "{{ entry.alias }}", "host_path": r"{{ entry.host_path }}", "writable": {{ entry.writable }}},
{% endfor %}
]

# Dangerous-location floor (spec FR-016, FR-079). Extendable, never
# reducible; no allowlist entry can override a match against it. Mirrors
# team_maker/tools/policy.py's DANGEROUS_LOCATIONS exactly — see
# tests/security/test_mount_allowlist.py for the parity check between the
# product-side module and this rendered copy.
_DANGEROUS_PREFIXES = (
    "/root", "/etc", "/boot", "/usr", "/var/run", "/dev", "/proc", "/sys",
    "c:/windows", "c:/users",
)


def _normalize_path(path_str: str) -> str:
    return path_str.replace("\\", "/").rstrip("/").lower()


def _sanitized_id(raw_path: str) -> str:
    """A stable, non-reversible identifier for a path with no operator
    alias — never the raw path itself (spec FR-070, FR-071)."""
    digest = hashlib.sha256(raw_path.encode("utf-8")).hexdigest()[:12]
    return f"mount-{digest}"


def _is_dangerous_location(resolved: Path) -> bool:
    normalized = _normalize_path(str(resolved))
    if normalized in ("", "c:", "d:", "/"):
        return True
    for prefix in _DANGEROUS_PREFIXES:
        if normalized == prefix or normalized.startswith(prefix + "/"):
            return True
    home = os.path.expanduser("~")
    if home and home != "~":
        home_norm = _normalize_path(home)
        if normalized == home_norm or normalized.startswith(home_norm + "/"):
            return True
    return False


def _evaluate_mount(requested_host_path: str) -> dict[str, Any]:
    """Resolve -> allow-check -> deny-check -> caller applies mode (D-8).
    Raises `ToolPolicyRefusal` naming the violated rule; never returns a
    degraded/partial result (FR-017)."""
    resolved = Path(requested_host_path).expanduser().resolve()

    matched = None
    for entry in MOUNT_ALLOWLIST:
        entry_resolved = Path(entry["host_path"]).expanduser().resolve()
        if resolved == entry_resolved:
            matched = entry
            break
        try:
            resolved.relative_to(entry_resolved)
            matched = entry
            break
        except ValueError:
            continue
    if matched is None:
        raise ToolPolicyRefusal(
            f"mount '{_sanitized_id(requested_host_path)}' is not in the operator-configured "
            f"allowlist — refusing rather than running without it"
        )

    if _is_dangerous_location(resolved):
        raise ToolPolicyRefusal(
            f"mount '{matched['alias']}' resolves to a location on the dangerous-location floor "
            f"and is refused regardless of allowlist contents"
        )

    return matched


def _check_sandbox_available() -> None:
    """Re-checked on every risky-tool call, not just once at import, so a
    sandbox that becomes unavailable mid-run (spec FR-082) is caught. Raises
    `ToolPolicyRefusal` naming which of the enumerated conditions occurred;
    never falls back to host execution."""
    docker_path = shutil.which("docker")
    if docker_path is None:
        raise ToolPolicyRefusal("sandbox could not be established: docker runtime is not installed")
    try:
        result = subprocess.run(
            ["docker", "info"], capture_output=True, text=True, timeout=10
        )
    except subprocess.TimeoutExpired:
        raise ToolPolicyRefusal("sandbox could not be established: docker daemon did not respond")
    except OSError as exc:
        raise ToolPolicyRefusal(f"sandbox could not be established: docker runtime unreachable ({exc})")
    if result.returncode != 0:
        raise ToolPolicyRefusal("sandbox could not be established: docker daemon is unreachable")


# `docker run IMAGE CMD...`: exit code 125 means docker itself failed to run
# the container (image pull, container creation, an unsupported resource
# flag); any other code is the CONTAINERIZED COMMAND's own exit status, which
# is ordinary tool output, not a sandbox-establishment failure. This is
# docker's own documented convention, not a team_maker invention — see
# https://docs.docker.com/engine/reference/run/#exit-status.
_DOCKER_CLI_FAILURE_CODE = 125
_IMAGE_ERROR_MARKERS = ("no such image", "pull access denied", "manifest unknown", "repository does not exist")
_CONTROL_ERROR_MARKERS = ("unknown flag", "--pids-limit", "--storage-opt", "not supported", "cannot set")


def _raise_on_docker_cli_failure(returncode: int, stderr: str) -> None:
    """FR-082: a docker-level failure (exit 125) is one of image-unavailable,
    control-unenforceable or generic container-creation-failed — each a
    distinctly named refusal, never returned as if the tool call succeeded."""
    if returncode != _DOCKER_CLI_FAILURE_CODE:
        return
    lowered = stderr.lower()
    if any(marker in lowered for marker in _IMAGE_ERROR_MARKERS):
        raise ToolPolicyRefusal("sandbox could not be established: sandbox image is unavailable")
    if any(marker in lowered for marker in _CONTROL_ERROR_MARKERS):
        raise ToolPolicyRefusal("sandbox could not be established: a declared resource control could not be enforced")
    raise ToolPolicyRefusal("sandbox could not be established: container creation failed")


def _capped_output(raw: str) -> str:
    """FR-075 + FR-077: output size is a mandatory, enforced limit. Exceeding
    it is a limit breach like any other — it terminates the call via
    `ToolPolicyRefusal` (recorded as a failed receipt once Phase 6 wires
    receipts to these events), not a silent truncation. A truncated-but-
    "successful" result would let an agent claim it read output that was
    actually cut off."""
    encoded = raw.encode("utf-8", errors="replace")
    if len(encoded) > MAX_OUTPUT_BYTES:
        raise ToolPolicyRefusal(
            f"output exceeded the {MAX_OUTPUT_BYTES}-byte limit and was terminated"
        )
    return raw


def _docker_resource_flags() -> list[str]:
    """The single set of resource-limit flags every risky-tool Docker
    invocation applies — shared so shell/code_writer/test_runner and
    docker_runner enforce identically (spec FR-008: no tool implements its
    own execution policy)."""
    return [
        "--network", SANDBOX_NETWORK,
        "--cpus", CPU_LIMIT,
        "--memory", MEMORY_LIMIT,
        "--pids-limit", str(MAX_PROCESSES),
        "--storage-opt", f"size={STORAGE_LIMIT}",
    ]


def _run_sandboxed(command: str, *, timeout: int = TIMEOUT_PROCESS_SECONDS) -> str:
    """The single enforced execution path for shell, code_writer and
    test_runner (spec FR-008, FR-009). Mandatory Docker sandbox — there is
    no unsandboxed branch (FR-012)."""
    _check_sandbox_available()
    os.makedirs(SANDBOX_WORKSPACE, exist_ok=True)
    env_flags: list[str] = []
    merged = {**SANDBOX_EXTRA_ENV, **{k: os.environ[k] for k in os.environ if k in SANDBOX_EXTRA_ENV}}
    for k, v in merged.items():
        env_flags += ["-e", f"{k}={v}"]
    cmd = [
        "docker", "run", "--rm",
        *_docker_resource_flags(),
        "-v", f"{SANDBOX_WORKSPACE}:/workspace",
        "-w", "/workspace",
        *env_flags,
        SANDBOX_IMAGE, "sh", "-c", command,
    ]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise ToolPolicyRefusal(f"execution exceeded the {timeout}s timeout limit and was terminated")
    _raise_on_docker_cli_failure(result.returncode, result.stderr)
    return _capped_output((result.stdout + result.stderr).strip() or "(no output)")


# ---------------------------------------------------------------------------
# Custom tool definitions — exactly one definition per tool name (FR-006)
# ---------------------------------------------------------------------------

@tool("shell")
def shell_tool(command: str) -> str:
    """Execute a shell command inside the mandatory Docker sandbox."""
    return _run_sandboxed(command)


@tool("code_writer")
def code_writer_tool(path: str, content: str) -> str:
    """Write content to a file inside the mandatory Docker sandbox, creating parent dirs as needed."""
    target = Path(path)
    if target.is_absolute():
        target = Path("/workspace") / target.relative_to("/") if target.is_absolute() and str(target).startswith("/") else target
    else:
        if target.parts and target.parts[0] == "workspace":
            target = Path("/workspace") / Path(*target.parts[1:])
        else:
            target = Path("/workspace") / target
    escaped = content.replace("'", "'\\''")
    return _run_sandboxed(
        f"mkdir -p \"$(dirname '{target}')\" && cat > '{target}' << 'EOF'\n{escaped}\nEOF"
    )


@tool("http_client")
def http_client_tool(url: str, method: str = "GET", body: str = "") -> str:
    """Make an HTTP request and return the response body (up to MAX_OUTPUT_BYTES). SAFE — no host command execution."""
    import urllib.request
    req = urllib.request.Request(url, method=method.upper())
    if body:
        req.data = body.encode()
    with urllib.request.urlopen(req, timeout=TIMEOUT_HTTP_SECONDS) as resp:
        # Read one byte past the cap so a body that actually exceeds it is
        # detected and refused by `_capped_output`, rather than silently
        # discarding the excess by never reading it in the first place.
        return _capped_output(resp.read(MAX_OUTPUT_BYTES + 1).decode(errors="replace"))


@tool("test_runner")
def test_runner_tool(path: str = ".", framework: str = "pytest") -> str:
    """Run the test suite inside the mandatory Docker sandbox. Supports pytest, npm, go, cargo."""
    cmds = {
        "pytest": f"cd {path} && python -m pytest -v --tb=short 2>&1 | tail -60",
        "npm":    f"cd {path} && npm test 2>&1 | tail -60",
        "go":     f"cd {path} && go test ./... 2>&1 | tail -60",
        "cargo":  f"cd {path} && cargo test 2>&1 | tail -60",
    }
    return _run_sandboxed(cmds.get(framework, cmds["pytest"]))


@tool("docker_runner")
def docker_runner_tool(image: str, command: str, mounts: str = "") -> str:
    """Run a container inside the mandatory sandbox policy. mounts: comma-separated host paths, each validated against the operator-configured allowlist."""
    _check_sandbox_available()
    mount_flags: list[str] = []
    for raw_mount in (mounts.split(",") if mounts else []):
        raw_mount = raw_mount.strip()
        if not raw_mount:
            continue
        host_part = raw_mount.split(":", 1)[0]
        entry = _evaluate_mount(host_part)
        container_path = raw_mount.split(":", 1)[1] if ":" in raw_mount else host_part
        mode = "rw" if entry["writable"] else "ro"
        mount_flags += ["-v", f"{entry['host_path']}:{container_path}:{mode}"]
    cmd = ["docker", "run", "--rm", *_docker_resource_flags(), *mount_flags, image, "sh", "-c", command]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=TIMEOUT_CONTAINER_SECONDS)
    except subprocess.TimeoutExpired:
        raise ToolPolicyRefusal(
            f"execution exceeded the {TIMEOUT_CONTAINER_SECONDS}s container timeout limit and was terminated"
        )
    _raise_on_docker_cli_failure(result.returncode, result.stderr)
    return _capped_output((result.stdout + result.stderr).strip() or "(no output)")


@tool("git_account")
def git_account_tool(action: str, repo: str = "", body: str = "") -> str:
    """
    Manage GitHub repos and PRs. SAFE — uses the GitHub API, not host command execution.
    action: create_repo | clone | list_repos | create_pr | list_prs
    repo: owner/name
    body: JSON-encoded params
    """
    token = os.environ.get("GITHUB_TOKEN", "")
    if not token:
        return "[error] GITHUB_TOKEN not set"
    try:
        from github import Github
        gh = Github(token)
        params = json.loads(body) if body else {}
        if action == "create_repo":
            user = gh.get_user()
            r = user.create_repo(repo, **{k: params[k] for k in ("private", "description") if k in params})
            return f"Created: {r.html_url}"
        if action == "clone":
            # FR-083: SAFE tools may not execute host commands, sandboxed or
            # not. This branch used to invoke git directly on the host. It
            # no longer executes anything; it hands back the URL for the
            # RISKY, sandboxed shell tool to clone with, keeping
            # git_account honestly API-only.
            r = gh.get_repo(repo)
            return f"Clone URL: {r.clone_url} (use the shell tool to clone it inside the sandbox)"
        if action == "list_repos":
            return "\n".join(r.full_name for r in gh.get_user().get_repos())
        if action == "create_pr":
            r = gh.get_repo(repo)
            pr = r.create_pull(
                title=params.get("title", "New PR"),
                body=params.get("body", ""),
                head=params.get("head", "main"),
                base=params.get("base", "main"),
            )
            return f"PR: {pr.html_url}"
        if action == "list_prs":
            r = gh.get_repo(repo)
            return "\n".join(f"#{pr.number} {pr.title}" for pr in r.get_pulls())
        return f"[error] unknown action: {action}"
    except ImportError:
        return "[error] PyGithub not installed: pip install PyGithub"
    except Exception as exc:
        return f"[error] {exc}"


@tool("state_reader")
def state_reader_tool(key: str) -> str:
    """Read a value from the shared team state store. SAFE."""
    value = read_state(key)
    if value is None:
        return f"(no entry for key: {key})"
    return json.dumps(value, indent=2) if isinstance(value, (dict, list)) else str(value)


@tool("state_writer")
def state_writer_tool(key: str, value: str) -> str:
    """Write a value to the shared team state store. SAFE."""
    try:
        parsed = json.loads(value)
    except json.JSONDecodeError:
        parsed = value
    write_state(key, parsed)
    return f"Stored {key!r}"


@tool("ci_tool")
def ci_tool_tool(action: str, repo: str, workflow: str = "", ref: str = "main") -> str:
    """Trigger or query GitHub Actions workflows. SAFE — uses the GitHub API. action: trigger | status"""
    token = os.environ.get("GITHUB_TOKEN", "")
    if not token:
        return "[error] GITHUB_TOKEN not set"
    import urllib.request, urllib.error
    headers = {"Authorization": f"token {token}", "Accept": "application/vnd.github+json"}
    if action == "trigger":
        url = f"https://api.github.com/repos/{repo}/actions/workflows/{workflow}/dispatches"
        req = urllib.request.Request(url, data=json.dumps({"ref": ref}).encode(),
                                     headers=headers, method="POST")
        try:
            urllib.request.urlopen(req, timeout=TIMEOUT_HTTP_SECONDS)
            return f"Triggered {workflow} on {ref}"
        except urllib.error.HTTPError as e:
            return f"[error] {e.code}: {e.read().decode()}"
    if action == "status":
        url = f"https://api.github.com/repos/{repo}/actions/runs?per_page=5"
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=TIMEOUT_HTTP_SECONDS) as resp:
            runs = json.loads(resp.read())["workflow_runs"]
        return "\n".join(f"#{r['id']} {r['name']} {r['status']} {r['conclusion']}" for r in runs)
    return f"[error] unknown action: {action}"

{% if context_dir %}

# ---------------------------------------------------------------------------
# Context reader — reads files from the user-supplied context directory (SAFE)
# ---------------------------------------------------------------------------

CONTEXT_DIR = Path("{{ context_dir }}")


@tool("context_reader")
def context_reader_tool(filename: str = "") -> str:
    """Read files from the project context directory. Pass empty string to list all files."""
    if not filename:
        if not CONTEXT_DIR.exists():
            return f"(context directory not found: {CONTEXT_DIR})"
        files = sorted(str(p.relative_to(CONTEXT_DIR)) for p in CONTEXT_DIR.rglob("*") if p.is_file())
        return "\n".join(files) if files else "(no files in context directory)"
    path = CONTEXT_DIR / filename
    if not path.exists():
        return f"(file not found: {filename!r} in {CONTEXT_DIR})"
    return _capped_output(path.read_text(encoding="utf-8", errors="replace"))
{% endif %}

# ---------------------------------------------------------------------------
# Tool registry — one entry per canonical name, no duplicates (FR-007)
# ---------------------------------------------------------------------------

TOOL_REGISTRY: dict[str, Any] = {
    "shell":          shell_tool,
    "code_writer":    code_writer_tool,
    "http_client":    http_client_tool,
    "test_runner":    test_runner_tool,
    "docker_runner":  docker_runner_tool,
    "git_account":    git_account_tool,
    "state_reader":   state_reader_tool,
    "state_writer":   state_writer_tool,
    "ci_tool":        ci_tool_tool,
{% if context_dir %}
    "context_reader": context_reader_tool,
{% endif %}
}

if _crewai_tools:
    TOOL_REGISTRY.update({
        "filesystem": [FileReadTool(), FileWriterTool()],
    })
    if os.environ.get("OPENAI_API_KEY"):
        TOOL_REGISTRY["code_reader"] = CodeDocsSearchTool()
    else:
        print("[warn] OPENAI_API_KEY not set — code_reader unavailable.")
    if os.environ.get("SERPER_API_KEY"):
        TOOL_REGISTRY["web_search"] = SerperDevTool()
    else:
        print("[warn] SERPER_API_KEY not set — web_search unavailable.")


class UnknownToolError(Exception):
    """A declared tool name is not in this package's registry (spec FR-059,
    FR-080). Raised rather than silently skipped: a package hand-edited
    after build, or one built by a pre-remediation version of team_maker, is
    not run with a declared tool silently absent."""


def get_tools_for(tool_names: list[str]) -> list:
    """Return tool instances for the given YAML tool name list. Raises
    `UnknownToolError` for any name not in the registry — no silent skip
    (FR-059)."""
    result = []
    for name in tool_names:
        entry = TOOL_REGISTRY.get(name)
        if entry is None:
            raise UnknownToolError(
                f"tool '{name}' is declared but not in this package's registry — "
                f"refusing rather than running without it"
            )
        if isinstance(entry, list):
            result.extend(entry)
        else:
            result.append(entry)
    return result
