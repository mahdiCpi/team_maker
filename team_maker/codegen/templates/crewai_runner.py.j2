# =============================================================================
# Control Character Sanitization (Story 4.4 Task 4)
# =============================================================================
# Removes ANSI escape sequences, OSC sequences, and other control characters
# to prevent terminal manipulation attacks when displaying transcript content.

def sanitize_control_characters(text: str) -> str:
    """Remove ANSI escape sequences, OSC sequences, and control characters from text.

    This prevents terminal manipulation attacks via control sequences in transcript content.
    Preserves printable characters, tabs, newlines, and carriage returns.

    Mirrors `team_maker/utils/text_sanitizer.py::sanitize_control_characters`'s
    patterns exactly (this template runs standalone, without team_maker
    installed, so it cannot import that module) — including the 8-bit
    CSI/OSC/ST equivalents (`\\x9b`/`\\x9d`/`\\x9c`) and the C1 control block
    (`\\x80-\\x9f`) that would otherwise bypass the ESC-prefixed patterns.
    """
    if not text:
        return text

    ansi_pattern = re.compile(r'(?:\x1b\[|\x9b)[0-9;:*]*[a-zA-Z]')
    osc_pattern = re.compile(r'(?:\x1b\]|\x9d)[^\x07\x1b\x9c]*(?:\x07|\x1b\x5c|\x9c)')
    control_pattern = re.compile(r'[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f]')

    result = ansi_pattern.sub('', text)
    result = osc_pattern.sub('', result)
    result = control_pattern.sub('', result)
    return result


def _print_transcript_entries(transcript: list["TranscriptEntry"], heading: str) -> None:
    """Print a transcript in the AC 4/5 hardened format: sanitized content,
    an unambiguous `::` header delimiter, and a length cap per entry."""
    if not transcript:
        return
    print(heading)
    for entry in transcript:
        sanitized_content = sanitize_control_characters(entry.content)
        target = f" -> {entry.target_role}" if entry.target_role else ""
        header = f"[{entry.sequence}] {entry.task_name} / {entry.agent_role}{target} :: {entry.kind}"
        print(header)
        capped_content = sanitized_content[:10000]
        if capped_content.strip():
            for line in capped_content.splitlines():
                print(f"    {line}")


# =============================================================================
# Transcript Capture (Story 4.4 Task 3)
# =============================================================================
# Minimal in-template transcript capture matching the in-process Runtime
# behavior. This allows standalone run_example.py to capture and display
# transcripts just like the in-process execution does.

if TYPE_CHECKING:
    from crewai.events.types.agent_events import AgentExecutionStartedEvent
    from crewai.events.types.logging_events import AgentLogsExecutionEvent
    from crewai.events.types.task_events import TaskCompletedEvent, TaskStartedEvent
    from crewai.events.types.tool_usage_events import (
        ToolUsageFinishedEvent,
        ToolUsageStartedEvent,
    )


# Transcript entry kinds - match team_maker/runtime/results.py constants
ENTRY_TASK_STARTED = "task_started"
ENTRY_TASK_COMPLETED = "task_completed"
ENTRY_AGENT_MESSAGE = "agent_message"
ENTRY_AGENT_ACTION = "agent_action"
ENTRY_DELEGATION = "delegation"
ENTRY_DELEGATION_RESULT = "delegation_result"


@dataclass
class TranscriptEntry:
    """One ordered, attributed moment in a run."""
    sequence: int
    kind: str
    agent_role: str
    task_name: str
    content: str
    target_role: Optional[str] = None


class SimpleTranscriptRecorder:
    """Captures an ordered, attributed transcript from one crew run.
    
    This is a simplified version of team_maker's TranscriptRecorder, suitable
    for standalone use in generated run_example.py templates. It subscribes
    to the crewai event bus to capture transcript entries.
    
    Usage:
        with SimpleTranscriptRecorder(task_owners) as recorder:
            result = crew.kickoff(...)
        transcript = recorder.entries()
    """

    def __init__(self, task_owners: Optional[dict[str, str]] = None) -> None:
        self._task_owners = dict(task_owners or {})
        self._pending: list[TranscriptEntry] = []
        self._lock = threading.Lock()
        self._registered: list[tuple[type, Callable]] = []

    def __enter__(self) -> "SimpleTranscriptRecorder":
        self._subscribe()
        return self

    def __exit__(self, exc_type, exc, tb) -> None:
        from crewai.events import crewai_event_bus
        try:
            crewai_event_bus.flush()
        except Exception:
            pass
        finally:
            self._unsubscribe()

    def entries(self) -> list[TranscriptEntry]:
        """Return all captured entries, ordered by emission sequence."""
        with self._lock:
            pending = list(self._pending)
        return sorted(pending, key=lambda entry: entry.sequence)

    def _subscribe(self) -> None:
        from crewai.events import crewai_event_bus
        from crewai.events.types.agent_events import AgentExecutionStartedEvent
        from crewai.events.types.logging_events import AgentLogsExecutionEvent
        from crewai.events.types.task_events import TaskCompletedEvent, TaskStartedEvent
        from crewai.events.types.tool_usage_events import (
            ToolUsageFinishedEvent,
            ToolUsageStartedEvent,
        )
        
        handlers = [
            (TaskStartedEvent, self._on_task_started),
            (TaskCompletedEvent, self._on_task_completed),
            (AgentExecutionStartedEvent, self._on_agent_started),
            (AgentLogsExecutionEvent, self._on_agent_turn),
            (ToolUsageStartedEvent, self._on_tool_started),
            (ToolUsageFinishedEvent, self._on_tool_finished),
        ]
        try:
            for event_type, handler in handlers:
                crewai_event_bus.on(event_type)(handler)
                self._registered.append((event_type, handler))
        except Exception:
            self._unsubscribe()
            raise

    def _unsubscribe(self) -> None:
        from crewai.events import crewai_event_bus
        while self._registered:
            event_type, handler = self._registered.pop()
            try:
                crewai_event_bus.off(event_type, handler)
            except Exception:
                pass

    def _add(self, kind: str, content: str, *, sequence: int, task_name: Optional[str] = None,
             agent_role: Optional[str] = None, target_role: Optional[str] = None) -> None:
        if not isinstance(sequence, int):
            return
        entry = TranscriptEntry(
            sequence=sequence,
            kind=kind,
            agent_role=agent_role or "unknown",
            task_name=task_name or "unknown",
            content=content,
            target_role=target_role,
        )
        with self._lock:
            self._pending.append(entry)

    def _on_task_started(self, source, event) -> None:
        task = getattr(event, "task", None)
        task_name = getattr(event, "task_name", None) or getattr(task, "name", None)
        self._add(
            ENTRY_TASK_STARTED,
            getattr(task, "description", "") or task_name or "",
            sequence=getattr(event, "emission_sequence", None),
            task_name=task_name,
            agent_role=getattr(getattr(task, "agent", None), "role", None),
        )

    def _on_task_completed(self, source, event) -> None:
        task = getattr(event, "task", None)
        task_name = getattr(event, "task_name", None) or getattr(task, "name", None)
        raw = ""
        output = getattr(event, "output", None)
        if output:
            raw = getattr(output, "raw", str(output))
        self._add(
            ENTRY_TASK_COMPLETED,
            str(raw)[:2000] if raw else "",
            sequence=getattr(event, "emission_sequence", None),
            task_name=task_name,
            agent_role=getattr(getattr(task, "agent", None), "role", None),
        )

    def _on_agent_started(self, source, event) -> None:
        # Exists to attribute turns; emits no entry itself
        pass

    def _on_agent_turn(self, source, event) -> None:
        agent_role = getattr(event, "agent_role", None)
        formatted = getattr(event, "formatted_answer", None)
        # AgentAction names a tool; AgentFinish is the turn's answer
        kind = ENTRY_AGENT_ACTION if getattr(formatted, "tool", None) else ENTRY_AGENT_MESSAGE
        text = ""
        if formatted:
            text = getattr(formatted, "text", None) or getattr(formatted, "output", None) or ""
        if isinstance(text, str):
            text = text[:2000]
        else:
            text = ""
        self._add(
            kind,
            text,
            sequence=getattr(event, "emission_sequence", None),
            task_name=getattr(event, "task_name", None),
            agent_role=agent_role,
        )

    def _on_tool_started(self, source, event) -> None:
        task_name = getattr(event, "task_name", None)
        agent_role = getattr(event, "agent_role", None)
        tool_name = getattr(event, "tool_name", None)
        # Check if this is a delegation tool
        if tool_name and str(tool_name).lower() in ("delegate_work_to_coworker", "ask_question_to_coworker"):
            args = self._parse_tool_args(getattr(event, "tool_args", None))
            target = args.get("coworker") or args.get("agent")
            if target and isinstance(target, str):
                delegated_task = args.get("task", "")
                if not isinstance(delegated_task, str):
                    delegated_task = str(delegated_task)
                self._add(
                    ENTRY_DELEGATION,
                    delegated_task[:500],
                    sequence=getattr(event, "emission_sequence", None),
                    task_name=task_name,
                    agent_role=agent_role,
                    target_role=target,
                )

    def _on_tool_finished(self, source, event) -> None:
        task_name = getattr(event, "task_name", None)
        agent_role = getattr(event, "agent_role", None)
        tool_name = getattr(event, "tool_name", None)
        if tool_name and str(tool_name).lower() in ("delegate_work_to_coworker", "ask_question_to_coworker"):
            args = self._parse_tool_args(getattr(event, "tool_args", None))
            target = args.get("coworker") or args.get("agent")
            if target and isinstance(target, str):
                output = getattr(event, "output", "")
                if isinstance(output, str):
                    output = output[:2000]
                else:
                    output = str(output)[:2000] if output else ""
                self._add(
                    ENTRY_DELEGATION_RESULT,
                    output,
                    sequence=getattr(event, "emission_sequence", None),
                    task_name=task_name,
                    agent_role=agent_role,
                    target_role=target,
                )

    @staticmethod
    def _parse_tool_args(raw) -> dict[str, Any]:
        """Parse tool_args which may be a JSON string or dict."""
        if isinstance(raw, dict):
            return raw
        if isinstance(raw, str) and raw.strip():
            try:
                parsed = json.loads(raw)
                return parsed if isinstance(parsed, dict) else {}
            except ValueError:
                return {}
        return {}

# ── Langfuse observability (optional) ────────────────────────────────────────
# Set LANGFUSE_PUBLIC_KEY + LANGFUSE_SECRET_KEY + LANGFUSE_HOST to enable.
# Creates one parent trace per crew run; every per-agent LLM call is nested
# under it as a generation via LiteLLM's Langfuse callback.
_LANGFUSE = None
_LANGFUSE_HOST = os.environ.get("LANGFUSE_HOST", "http://localhost:3000")
if os.environ.get("LANGFUSE_PUBLIC_KEY"):
    try:
        from langfuse import Langfuse as _LangfuseClient
        _LANGFUSE = _LangfuseClient(
            public_key=os.environ["LANGFUSE_PUBLIC_KEY"],
            secret_key=os.environ.get("LANGFUSE_SECRET_KEY", ""),
            host=_LANGFUSE_HOST,
        )
        # Route every LiteLLM call (i.e. every agent LLM call) to Langfuse.
        # This gives a per-agent, per-call breakdown nested under the parent trace.
        try:
            import litellm as _litellm
            _litellm.success_callback = ["langfuse"]
            _litellm.failure_callback = ["langfuse"]
            print(f"[langfuse] tracing enabled → {_LANGFUSE_HOST} (per-agent LLM spans active)")
        except Exception as _ll_err:
            print(f"[langfuse] tracing enabled → {_LANGFUSE_HOST} (litellm callback skipped: {_ll_err})")
    except Exception as _lf_err:
        print(f"[langfuse] init skipped — {_lf_err}")
# ─────────────────────────────────────────────────────────────────────────────

TEAM_ROOT = Path(__file__).parent
{% if orchestrator_role %}
ORCHESTRATOR_ROLE = "{{ orchestrator_role }}"
{% else %}
ORCHESTRATOR_ROLE = None
{% endif %}

with (TEAM_ROOT / "routing_config.yaml").open() as _f:
    _ROUTING: dict = yaml.safe_load(_f).get("routing", {})

# Maps agent display role (from agents/*.yaml) → routing key (snake_case filename)
_display_to_routing: dict[str, str] = {}

# Tracks which tasks are pending/completed so error messages name the failing agent
_exec_state: dict = {"completed": [], "pending": [], "last_agent": "none"}


def _agent_label(routing_key: str) -> str:
    cfg = _ROUTING.get(routing_key, {})
    return f"{cfg.get('provider', '?')}/{cfg.get('model', '?')}"


def _validate_env() -> None:
    """Fail fast if any required API key is missing before spending any credits."""
    missing = []
    for role, cfg in _ROUTING.items():
        env = cfg.get("api_key_env")
        if env and not os.environ.get(env):
            missing.append(f"  {role}: {env}")
    if missing:
        msg = "Missing required API keys — set these environment variables before running:\n" + "\n".join(missing)
        _notify("STARTUP BLOCKED — missing API keys", msg)
        raise SystemExit(f"\n[error] {msg}")


def _build_llm(role: str):
    cfg = _ROUTING.get(role, {})
    if not cfg:
        return None
    provider = cfg.get("provider", "anthropic")
    model = cfg.get("model", "claude-sonnet-4-6")
    if provider == "ollama":
        return LLM(model=f"ollama/{model}", base_url=cfg.get("base_url", "http://localhost:11434"))
    return LLM(model=f"{provider}/{model}")


def load_agent(role: str) -> Agent:
    cfg_path = TEAM_ROOT / "agents" / f"{role}.yaml"
    with cfg_path.open() as f:
        cfg = yaml.safe_load(f)
    agent = Agent(
        role=cfg["role"],
        goal=cfg["goal"],
        backstory=cfg["backstory"],
        llm=_build_llm(role),
        tools=get_tools_for(cfg.get("tools", [])),
        verbose=True,
        allow_delegation=cfg.get("is_orchestrator", False),
    )
    _display_to_routing[cfg["role"]] = role
    return agent


def load_task(name: str, agents: dict[str, Agent]) -> Task:
    cfg_path = TEAM_ROOT / "tasks" / f"{name}.yaml"
    with cfg_path.open() as f:
        cfg = yaml.safe_load(f)
    return Task(
        description=cfg["description"],
        expected_output=cfg["expected_output"],
        agent=agents[cfg["agent_role"]],
    )


def _on_task_done(output) -> None:
    """Fires after each task completes. Sends Telegram with agent name + model + output preview."""
    display_role = getattr(output, "agent", "unknown")
    routing_key = _display_to_routing.get(display_role, display_role.lower().replace(" ", "_"))
    label = _agent_label(routing_key)
    raw = str(getattr(output, "raw", output))[:600]

    if _exec_state["pending"]:
        done = _exec_state["pending"].pop(0)
        _exec_state["completed"].append(done)
    _exec_state["last_agent"] = f"{display_role} ({label})"

    remaining = len(_exec_state["pending"])
    _notify(
        f"Task done — {display_role} [{label}]",
        f"Agent:           {display_role}\n"
        f"Model:           {label}\n"
        f"Tasks remaining: {remaining}\n\n"
        f"Output preview:\n{raw}",
    )


def main() -> None:
    _validate_env()

    agent_roles = [{% for a in team.agents %}"{{ a.role }}"{% if not loop.last %}, {% endif %}{% endfor %}]
    agents = {role: load_agent(role) for role in agent_roles}

    task_names = [{% for t in team.tasks %}"{{ t.name }}"{% if not loop.last %}, {% endif %}{% endfor %}]
    tasks = [load_task(name, agents) for name in task_names]

    _exec_state["pending"] = list(tasks)
    
    # Task owners for transcript attribution (Story 4.4 Task 3)
    # Maps task name -> agent role that owns it
    task_owners = {t.name: t.agent.role for t in tasks}

{% if orchestrator_role %}
    crew = Crew(
        agents=list(agents.values()),
        tasks=tasks,
        process=Process.hierarchical,
        manager_agent=agents["{{ orchestrator_role }}"],
        task_callback=_on_task_done,
        verbose=True,
    )
{% else %}
    crew = Crew(
        agents=list(agents.values()),
        tasks=tasks,
        process=Process.sequential,
        task_callback=_on_task_done,
        verbose=True,
    )
{% endif %}

    roster = "\n".join(f"  {role}: {_agent_label(role)}" for role in agent_roles)
    task_summary = "\n".join(
        f"  {t.description[:60]}… → {_display_to_routing.get(getattr(t.agent, 'role', ''), '?')}"
        for t in tasks
    )
    _notify(
        "Run started",
        f"Tasks ({len(tasks)}):\n{task_summary}\n\nAgent roster:\n{roster}",
    )

    goal = "Build a production-ready {{ team.team_name }} following best practices."
    _lf_trace = (
        _LANGFUSE.trace(
            name="{{ team.team_name }}",
            input={"goal": goal},
            tags=["crewai", "team_maker"],
        ) if _LANGFUSE else None
    )
    if _lf_trace:
        try:
            import litellm as _litellm
            os.environ["LANGFUSE_TRACE_ID"] = _lf_trace.id
        except Exception:
            pass
    
    # AC 3: Capture transcript (Story 4.4 Task 3)
    # Use SimpleTranscriptRecorder to capture transcript entries during execution
    transcript: list[TranscriptEntry] = []
    recorder: Optional[SimpleTranscriptRecorder] = None
    try:
        with SimpleTranscriptRecorder(task_owners) as recorder:
            result = crew.kickoff(inputs={"goal": goal})
        # Read after `__exit__` (which flushes the event bus), matching the
        # failure path below and CrewAIExecutionEngine — reading inside the
        # `with` block can miss events the bus delivers asynchronously.
        transcript = recorder.entries()

        if _lf_trace:
            _lf_trace.update(output=str(result)[:2000])
            _LANGFUSE.flush()

        _print_transcript_entries(transcript, "\n--- TRANSCRIPT ---")

        _notify(
            "Run completed successfully",
            f"The team finished without errors.\n\nFinal output:\n{str(result)[:2000]}",
        )
        print("\n--- RESULT ---")
        print(result)
    except KeyboardInterrupt:
        # AC 1: Preserve the partial transcript on this failure path too — an
        # interrupted run is a failed run, same as any exception below.
        if recorder is not None:
            transcript = recorder.entries()
        _print_transcript_entries(transcript, "\n--- PARTIAL TRANSCRIPT (run interrupted) ---")
        if _lf_trace:
            _lf_trace.update(output="interrupted")
            _LANGFUSE.flush()
        _notify(
            "Run interrupted",
            f"Stopped by keyboard interrupt.\n"
            f"Last active agent: {_exec_state['last_agent']}\n"
            f"Completed tasks: {len(_exec_state['completed'])}/{len(tasks)}",
        )
        raise SystemExit(1)
    except Exception as exc:
        # AC 3: Return partial transcript on failed runs (Story 4.4 Task 3)
        # Even on failure, the recorder has captured entries up to the failure point
        # Retrieve them before handling the exception
        if recorder is not None:
            transcript = recorder.entries()

        _print_transcript_entries(transcript, "\n--- PARTIAL TRANSCRIPT (run failed) ---")

        # Continue with existing error handling
        err_type = type(exc).__name__
        err_msg = str(exc)
        is_auth = any(x in err_msg.lower() or x in err_type.lower()
                      for x in ("authentication", "api_key", "unauthorized", "invalid_api"))
        is_token = any(x in err_msg.lower()
                       for x in ("context_window", "token", "max_tokens", "too long", "length"))
        is_rate = any(x in err_msg.lower() or x in err_type.lower()
                      for x in ("ratelimit", "rate_limit", "429", "529", "overloaded"))
        is_billing = any(x in err_msg.lower()
                         for x in ("billing", "quota", "insufficient_quota", "payment", "402"))

        if is_auth:
            category = "AUTH ERROR"
        elif is_billing:
            category = "BILLING / QUOTA EXHAUSTED"
        elif is_token:
            category = "TOKEN LIMIT"
        elif is_rate:
            category = "RATE LIMIT (retries exhausted)"
        else:
            category = "RUNTIME ERROR"

        failing_agent = "unknown"
        if _exec_state["pending"]:
            pending_task = _exec_state["pending"][0]
            agent_obj = getattr(pending_task, "agent", None)
            if agent_obj:
                display = getattr(agent_obj, "role", "unknown")
                routing_key = _display_to_routing.get(display, "")
                failing_agent = f"{display} ({_agent_label(routing_key)})"

        if _lf_trace:
            _lf_trace.update(output=f"FAILED [{category}]: {err_type}: {err_msg[:500]}")
            _LANGFUSE.flush()

        body = (
            f"Category:        {category}\n"
            f"Failing agent:   {failing_agent}\n"
            f"Last completed:  {_exec_state['last_agent']}\n"
            f"Tasks done:      {len(_exec_state['completed'])}/{len(tasks)}\n\n"
            f"Error type:      {err_type}\n"
            f"Error message:   {err_msg[:500]}\n\n"
            f"Partial results in: state/team_state.json\n"
            f"Re-run after resolving the issue above."
        )
        _notify(f"Run FAILED — {category}", body)
        print(f"\n[error] {category}: {err_type}: {err_msg}")
        print("Partial results saved to: state/team_state.json")
        raise SystemExit(1)


if __name__ == "__main__":
    main()
